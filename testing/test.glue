func main() -> i32 {

    let b: i32 = {
        let i: i32 = 5;
        i += 5 / 2;
        yield i;
    } -> i32;

    {
        let c: i32 = 2;
         b /= c;
         {
            c += 35 -2;
            b *= c;
            yield;
            b += 1;
         }
         yield;
         b += 1;
    }


    return b;

}