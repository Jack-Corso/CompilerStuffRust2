func main() -> i32 {

    let i: i32 = 250;

    let b: i32 = {
        let i: i32 = 5;
        i += 5 / 2;
        yield i;
    } -> i32;

    {
        let c: i32 = 2;
         b /= c;
         {
            c += 35 - 2;
            b *= c;
            yield;
            b += 1;
         }
         yield;
         b += 1;
    }

    if (b) {
        b = 0;
    }

    b = {
        if (b) {
            yield 100;
        } else {
            yield 3;
        }
    } -> i32;

    return b;

}

func test(a: i32, b: i32) -> i32 {
    return a + b;
}